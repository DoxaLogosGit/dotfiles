{
  "//": "Copy to models.json and edit for this machine. Never committed.",
  "//providers": "Add internal/corporate gateways here, not in the repo.",
  "providers": {
    "ollama": {
      "api": "openai-completions",
      "apiKey": "ollama",
      "baseUrl": "http://localhost:11434/v1",
      "models": [
        {
          "id": "qwen35-pi",
          "contextWindow": 262144,
          "reasoning": true,
          "input": ["text", "image"]
        }
      ]
    },
    "ExampleGateway": {
      "//": "OpenAI-compatible corporate gateway. Keep the real baseUrl local.",
      "name": "ExampleGateway",
      "api": "openai-completions",
      "baseUrl": "https://gateway.example.internal/v1",
      "//apiKey": "Shell command form keeps the secret out of this file.",
      "apiKey": "!printenv EXAMPLE_API_KEY",
      "compat": {
        "supportsReasoningEffort": true,
        "supportsUsageInStreaming": true,
        "maxTokensField": "max_tokens"
      },
      "models": [
        {
          "id": "some-model-id",
          "contextWindow": 200000,
          "maxTokens": 64000,
          "reasoning": true,
          "input": ["text", "image"]
        }
      ]
    }
  }
}

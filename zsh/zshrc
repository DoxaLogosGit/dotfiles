# ~/.zshrc

# ── Homebrew (Apple Silicon or Intel — no-op if brew isn't installed) ─────────
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# TERM is set before oh-my-zsh: its key bindings read terminfo for whatever
# TERM is in effect when it loads.
export TERM="xterm-256color"

# ── oh-my-zsh ────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # starship (below) owns the prompt
# zsh-syntax-highlighting must stay last.
plugins=(
    git
    tmux
    colorize
    colored-man-pages
    dirhistory
    zsh-autosuggestions
    zsh-syntax-highlighting
)
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ── Completion behaviour ─────────────────────────────────────────────────────
# Arrow-key menu, case-insensitive + substring + fuzzy path matching.
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
setopt AUTO_CD                 # `cd` optional for a bare directory name
setopt EXTENDED_GLOB
setopt INTERACTIVE_COMMENTS
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY

# Home/End/Delete — terminals disagree on these escapes, so bind both forms.
bindkey '^[[H'  beginning-of-line
bindkey '^[OH'  beginning-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[F'  end-of-line
bindkey '^[OF'  end-of-line
bindkey '^[[4~' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word      # Ctrl+Right
bindkey '^[[1;5D' backward-word     # Ctrl+Left

# ── Environment ──────────────────────────────────────────────────────────────
export EDITOR="nvim"
export NVM_DIR="$HOME/.nvm"
export ODIN_ROOT="$HOME/projects/Odin"
export BUN_INSTALL="$HOME/.bun"
export ENABLE_TOOL_SEARCH="true"

typeset -U path PATH            # keep $PATH de-duplicated
path=(
    "$HOME/.cargo/bin"
    "$HOME/.local/bin"
    "$HOME/.local/bin/yubico-authenticator"
    "$BUN_INSTALL/bin"
    "$HOME/projects/Odin"
    "$HOME/projects/ols"
    "$HOME/.nvm"
    "$HOME/.lmstudio/bin"
    $path
)
# Linux-only tool locations.
[[ "$(uname -s)" == "Linux" ]] && path=(/opt/IDriveForLinux/bin $path)

# ── Aliases & functions ──────────────────────────────────────────────────────
alias ll="eza --icons=always --color=always --color-scale=all -l --git"

# Debian and Raspbian install bat as `batcat`: the name `bat` already belongs
# to bacula-console-qt there. Without this, `bat` simply does not exist on the
# Pi. Guarded on batcat rather than on the OS, so it is a no-op wherever the
# binary keeps its own name.
command -v batcat >/dev/null 2>&1 && alias bat=batcat

c()  { CLAUDE_CONFIG_DIR="$HOME/.claude"      "$HOME/.local/bin/claude" "$@"; }
cw() { CLAUDE_CONFIG_DIR="$HOME/.claude-work" "$HOME/.local/bin/claude" "$@"; }

# yazi — cd to the directory yazi exited in
y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)" || return
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
        builtin cd -- "$cwd" || true
    fi
    rm -f -- "$tmp"
}

# zellij helpers
zm() { zellij attach MAIN 2>/dev/null || zellij --session MAIN; }
zdump() {
    local session dest
    # Prefer the session we are sitting in. Only fall back to scanning when
    # run from outside zellij. Live sessions carry no marker in `list-sessions`
    # (only exited ones are labelled), so filter EXITED out rather than
    # grepping for ATTACHED, which this zellij never prints.
    session="$ZELLIJ_SESSION_NAME"
    if [[ -z "$session" ]]; then
        local -a live
        live=(${(f)"$(zellij list-sessions -n 2>/dev/null | grep -v 'EXITED' | awk 'NF {print $1}')"})
        case ${#live} in
            0) echo "zdump: no live zellij session" >&2; return 1 ;;
            1) session="${live[1]}" ;;
            *) echo "zdump: several live sessions (${live}); run from inside one" >&2; return 1 ;;
        esac
    fi
    # Layouts stay machine-local: they embed absolute cwd paths and
    # per-machine commands, so they must never be written into the repo.
    dest="$HOME/.config/zellij/layouts/${session}.kdl"
    mkdir -p "${dest:h}" || return 1
    # Dump to a temp file first: a redirect would truncate a good layout
    # before we know the dump succeeded, and on case-insensitive filesystems
    # (APFS) "MAIN" and "main" are the same file.
    local tmp
    tmp="$(mktemp "${dest}.XXXXXX")" || return 1
    if ! zellij -s "$session" action dump-layout > "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        echo "zdump: failed to dump '$session'" >&2
        return 1
    fi
    if [[ ! -s "$tmp" ]]; then
        rm -f "$tmp"
        echo "zdump: refusing to write an empty layout for '$session'" >&2
        return 1
    fi
    mv "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
    # mktemp creates 0600; restore normal config-file perms.
    chmod 644 "$dest"
    echo "zdump: wrote ${session}.kdl to ${dest:h}"
}

# Refresh desktop-session vars inside tmux so the Obsidian flatpak CLI works.
if [[ -n "$TMUX" ]]; then
    for _var in DBUS_SESSION_BUS_ADDRESS DISPLAY WAYLAND_DISPLAY; do
        _val="$(tmux show-environment "$_var" 2>/dev/null)"
        [[ "$_val" == "$_var="* ]] && export "$_var=${_val#*=}"
    done
    unset _var _val
fi

# ── fzf ──────────────────────────────────────────────────────────────────────
export FZF_DEFAULT_COMMAND="fd --hidden --follow --exclude .git"
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --preview-window=right:60%:wrap"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
if command -v fzf >/dev/null 2>&1; then
    # fzf >= 0.48 ships its own shell integration; older builds ship files.
    if fzf --zsh >/dev/null 2>&1; then
        source <(fzf --zsh)
    else
        for _f in /usr/share/fzf/shell/key-bindings.zsh \
                  /usr/share/doc/fzf/examples/key-bindings.zsh \
                  /usr/share/zsh/site-functions/fzf; do
            [[ -f "$_f" ]] && source "$_f"
        done
        unset _f
    fi
fi

# ── Tool integrations (guarded — no-op if the tool isn't installed) ───────────
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v zoxide   >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v mise     >/dev/null 2>&1 && eval "$(mise activate zsh)"
# atuin binds Ctrl+R, so it must load after fzf's key bindings.
command -v atuin    >/dev/null 2>&1 && eval "$(atuin init zsh)"

# Delete key sends DEL rather than an escape sequence.
bindkey "^[[3~" delete-char

# ── nvm (no-op if not installed) ──────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ]         && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# ── bun ───────────────────────────────────────────────────────────────────────
# BUN_INSTALL and its PATH entry are already set above; only completions here.
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# ── OS-specific ───────────────────────────────────────────────────────────────
case "$(uname -s)" in
    Darwin)
        # Corporate TLS interception: Node and the AWS CLI do not read the
        # macOS keychain, so point them at an exported system CA bundle.
        # Generate with: scripts/export-system-ca.sh
        if [[ -f "$HOME/.config/certs/system-ca.pem" ]]; then
            export NODE_EXTRA_CA_CERTS="$HOME/.config/certs/system-ca.pem"
            export AWS_CA_BUNDLE="$NODE_EXTRA_CA_CERTS"
            export REQUESTS_CA_BUNDLE="$NODE_EXTRA_CA_CERTS"
        fi
        ;;
    Linux)
        alias idrive="/opt/IDriveForLinux/bin/idrive"
        ;;
esac

# Machine/company-local additions that shouldn't live in the shared dotfiles
# repo: credentials, internal endpoints, per-machine identity. Sourced last so
# it can override anything above.
#
# AWS credentials belong here (or better, use `aws sso login` + AWS_PROFILE).
# Never export long-lived keys from this tracked file.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local


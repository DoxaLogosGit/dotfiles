.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Backup files
*.bak
*.bak.*
*.backup

# Local overrides (for machine-specific config)
*.local

# Secrets (never commit these)
.env
*.secret
credentials*
opencode/

# Superpowers specs/plans (kept local, not committed)
docs/superpowers/

# Zellij layouts are machine-local: they embed absolute cwd paths and
# per-machine commands, so they must not be shared across machines.
# Live layouts belong in ~/.config/zellij/layouts/ (see zdump).
zellij/layouts/
